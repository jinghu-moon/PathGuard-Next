#!/system/bin/sh

MODDIR=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
RUNDIR="$MODDIR/run"
KO="$MODDIR/bin/pathguard_hide1.ko"
CONTROL="$MODDIR/bin/hide1_control"
LOG="$RUNDIR/control.log"
EXPECTED_RELEASE="6.12.23-android16-5-g16e473de48a3-abogki462654244-4k"

mkdir -p "$RUNDIR"

log() {
  echo "[$(date '+%Y-%m-%dT%H:%M:%S' 2>/dev/null || echo now)] $*" >> "$LOG"
}

die() {
  log "ERROR: $*"
  echo "error: $*" >&2
  exit 1
}

ksud_bin() {
  if [ -x /data/adb/ksu/bin/ksud ]; then
    echo /data/adb/ksu/bin/ksud
  elif command -v ksud >/dev/null 2>&1; then
    command -v ksud
  else
    return 1
  fi
}

run_control() {
  "$CONTROL" "$@"
}

run_in_target_ns() {
  PID="$1"
  shift
  if [ -x /system/bin/nsenter ]; then
    /system/bin/nsenter -t "$PID" -m "$CONTROL" "$@"
  elif command -v nsenter >/dev/null 2>&1; then
    nsenter -t "$PID" -m "$CONTROL" "$@"
  else
    die "nsenter is required for target mount namespace operations"
  fi
}

case "${1:-status}" in
  load)
    [ "$(uname -r 2>/dev/null)" = "$EXPECTED_RELEASE" ] || die "kernel release is not admitted"
    [ -f "$KO" ] || die "missing $KO"
    if grep -q '^pathguard_hide1 ' /proc/modules 2>/dev/null; then
      log "already loaded"
      exit 0
    fi
    KSU="$(ksud_bin)" || die "SukiSU/KernelSU ksud not found"
    MODE="${2:-1}"
    case "$MODE" in
      0|1|2|3) ;;
      *) die "shadow mode must be 0(all), 1(i_op), 2(f_op), or 3(d_op)" ;;
    esac
    log "loading $KO through $KSU with shadow_mode=$MODE"
    "$KSU" insmod "$KO" "shadow_mode=$MODE" || die "ksud insmod failed"
    log "load complete; shadow_mode=$MODE; module is INACTIVE until install/enable"
    ;;
  unload)
    run_control disable >/dev/null 2>&1 || true
    run_control clear >/dev/null 2>&1 || true
    rmmod pathguard_hide1 || die "rmmod failed"
    log "unload complete"
    ;;
  status)
    run_control status
    ;;
  install)
    [ "$#" -eq 6 ] || die "usage: $0 install <uid> <pid> <generation> <parent> <basename>"
    PID="$3"
    log "install uid=$2 pid=$3 generation=$4 parent=$5 basename=$6"
    run_in_target_ns "$PID" install "$2" "$3" "$4" "$5" "$6"
    ;;
  enable)
    [ "$#" -eq 3 ] || die "usage: $0 enable <pid> <generation>"
    log "ENABLE pid=$2 generation=$3 (high risk; no retry performed)"
    run_in_target_ns "$2" enable "$3"
    ;;
  disable)
    run_control disable
    ;;
  clear)
    run_control clear
    ;;
  *)
    cat >&2 <<EOF
PathGuard Hide 1.0 Lab: manual controls only
  $0 load [mode: 1=i_op, 2=f_op, 3=d_op, 0=all]
  $0 status
  $0 install <uid> <pid> <generation> <parent> <basename>
  $0 enable <pid> <generation>   # high-risk; may reboot this device
  $0 disable
  $0 clear
  $0 unload

The package never enables a rule automatically. Keep a second adb/root shell
open before testing ENABLE and collect /sys/fs/pstore after any reboot.
EOF
    exit 2
    ;;
esac
